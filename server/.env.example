PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# MongoDB Atlas Connection URI
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/joborbit_db?retryWrites=true&w=majority&authSource=admin

# JWT Authentication
JWT_SECRET=your_jwt_secret_key_here
JWT_EXPIRES_IN=7d

# Optional Resend email notifications
RESEND_API_KEY=
EMAIL_FROM=

# Optional private S3-compatible resume storage
S3_BUCKET=
S3_REGION=us-east-1
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# Optional OpenAI-compatible skill matching (uses safe fallbacks if unset)
AI_API_URL=https://api.openai.com/v1/chat/completions
AI_API_KEY=
AI_MODEL=

# Optional Gemini Career Assistant (uses safe fallbacks if unset)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
